# Control Horario — reglas para Apache (Hostalia)
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pasar la cabecera Authorization a PHP (necesario con PHP como CGI/FastCGI)
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

  # API → front controller
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # SPA (React, BrowserRouter): cualquier otra ruta que no sea un fichero
  # real (assets del build incluidos) → index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>